{
  "name": "fe-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Field engineer job booking and tracking app for network installations",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed.js --demo",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
